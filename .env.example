# Подключение к PostgreSQL (по умолчанию совпадает с docker-compose.yml)
DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/medialux

# Ключ подписи JWT и cookie корзины. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 — если приложение работает за HTTPS (cookie с флагом Secure)
COOKIE_SECURE=0
# 1 — если перед приложением стоит reverse-proxy (доверять X-Forwarded-For)
TRUST_PROXY=0

# Семантический поиск (нужен requirements-ml.txt)
# SEARCH_BI_ENCODER_MODEL=intfloat/multilingual-e5-small
# SEARCH_CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# SEARCH_INDEX_DIR=search_artifacts
